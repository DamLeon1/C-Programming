Array of strings:
Array of strings (Needs 2 indices) = char example[# of strings][length of each string including null terminator ‘\0’]. Each string is like a row and each character is like a column.
To replace a character of one of the strings in a certain position do example[which string to edit (row)][which character to replace/change (column)] = ‘Some character’; 

int main() {


    char fruits[][10] = {"Apple","Banana","Coconut","Lemon"};
    int size = sizeof(fruits) / sizeof(fruits[0]);


    fruits[0][0] = 'e'; // To replace row 0 and column 0
    fruits[0][4] = 'A'; // To replace row 0 and column 4


    fruits[1][0] = 'e'; // To replace row 1 and column 0
    fruits[1][4] = 'A'; // To replace row 1 and column 4


    fruits[2][0] = 'e'; // To replace row 2 and column 0
    fruits[2][4] = 'A'; // To replace row 2 and column 4


    for (int i = 0; i < size; i++) {
        printf("%s\n", fruits[i]);
    }


    return 0;

